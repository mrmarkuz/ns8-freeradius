{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get freeradius settings",
    "$id": "http://nethserver.org/json-schema/task/input/freeradius/get-configuration",
    "description": "Get freeradius settings",
    "examples": [
        {
            "host": "freeradius.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "clients": [
                {
                    "name": "ap-office",
                    "ipaddr": "192.168.1.10",
                    "secret": "use-a-long-random-string"
                }
            ],
            "ldap_domain": "ad.example.org"
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt",
        "clients",
        "ldap_domain"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'freeradius.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "clients": {
            "type": "array",
            "title": "RADIUS clients",
            "description": "Devices allowed to send requests (access points, switches, VPN gateways)",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "ipaddr",
                    "secret"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Short name of the client, used in the logs",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
                    },
                    "ipaddr": {
                        "type": "string",
                        "description": "IPv4/IPv6 address or network in CIDR notation",
                        "minLength": 2
                    },
                    "secret": {
                        "type": "string",
                        "description": "Shared secret, 8 to 128 printable ASCII characters without double quote and backslash",
                        "minLength": 8,
                        "maxLength": 128
                    }
                }
            }
        },
        "ldap_domain": {
            "type": "string",
            "title": "User domain",
            "description": "NS8 user domain whose accounts can log in; an empty string means none"
        }
    }
}
