# Bind the instance to one NS8 user domain (or to none). Accounts of that
# domain can then log in with methods that send the password to the server
# (PAP, TTLS/PAP): it is checked with an LDAP bind through Ldapproxy.
# When "ldap_domain" is missing the current binding is left alone.

import json
import sys

import agent
import cluster.userdomains

data = json.load(sys.stdin)

if "ldap_domain" not in data:
    sys.exit(0)

domain = data["ldap_domain"]

rdb = agent.redis_connect(use_replica=True)
if domain and domain not in cluster.userdomains.list_domains(rdb):
    agent.set_status('validation-failed')
    json.dump([{'field': 'ldap_domain', 'parameter': 'ldap_domain', 'value': domain, 'error': 'ldap_domain_not_found'}], fp=sys.stdout)
    sys.exit(4)

agent.set_env("RADIUS_LDAP_DOMAIN", domain)
# tell the core which domain the module uses (an empty list unbinds)
agent.bind_user_domains([domain] if domain else [])
